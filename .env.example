# Database URLs
DATABASE_URL="postgresql://user:password@localhost:5432/inkflow"
MONGODB_URI="mongodb://localhost:27017/inkflow"
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_SECRET="your_secret_key"

# Payment Gateways (Cashfree)
CASHFREE_APP_ID="TEST_APP_ID"
CASHFREE_SECRET_KEY="TEST_SECRET_KEY"
CASHFREE_ENV="TEST"  # TEST or PROD

# Service Ports
AUTH_SERVICE_PORT=4001
ASSIGNMENT_SERVICE_PORT=4002
MATCHING_SERVICE_PORT=4003
BIDDING_SERVICE_PORT=4004
PAYMENT_SERVICE_PORT=4005
ESCROW_SERVICE_PORT=4006
COMMUNICATION_SERVICE_PORT=4007
QUALITY_SERVICE_PORT=4008

# =============================================================================
# Writely API Gateway — environment variables
# Copy this file to:
#   gateway/api-gateway/.env   (for local dev — gitignored)
#   OR set the same keys in your Render service's Environment tab (production)
# =============================================================================

# --- Cashfree Payment Gateway (REQUIRED) ---
# Get these from https://merchant.cashfree.com → Developers → API Keys
CASHFREE_APP_ID=TEST_APP_ID
CASHFREE_SECRET_KEY=TEST_SECRET_KEY
# TEST = sandbox.cashfree.com  |  PROD = api.cashfree.com
# Same secret is used for webhook HMAC signature verification.
CASHFREE_ENV=TEST

# --- Google GenAI (REQUIRED for AI support chat) ---
# Get from https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=

# --- Firebase Admin SDK (REQUIRED in production) ---
# In LOCAL DEV: instead of this var, drop the JSON file at
#   gateway/api-gateway/serviceAccountKey.json   (gitignored)
# In PRODUCTION (Render): paste the FULL service-account JSON as a single line.
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# --- Sentry (OPTIONAL) — error monitoring ---
# Leave blank to disable. Get DSN from https://sentry.io
SENTRY_DSN=
NODE_ENV=development

# --- Server ---
# Render sets PORT automatically; override only for local dev if 5001 is taken.
PORT=5001

# =============================================================================
# Frontend (Netlify) — set these in Netlify → Site Settings → Environment
# =============================================================================
# Currently the API URL is hardcoded in shared/utils/logic.js, so no
# frontend env var is required. If you fork to a different Render URL,
# update the API_URL constant in that file.

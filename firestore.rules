rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Rule 19 & 02: SUSPENSION CHECK ---
    // Blocks any user who is banned or has soft-deleted their account.
    function isNotSuspended() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'DELETED';
    }

    // --- USER PROFILES ---
    match /users/{userId} {
      // FIX #5: Users can ONLY read their own profile.
      // Previously `allow read: if request.auth != null` let ANY logged-in user
      // read ANY other user's document (exposing phone, city, pincode, role, etc.).
      // Writer/seeker public profile data (avgRating, displayName) must be fetched
      // via the backend API which exposes only safe, curated fields.
      allow read: if isNotSuspended() && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Users CANNOT modify their own subscription/wallet status — backend only
      allow update: if isNotSuspended() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'writerSubscription', 'role', 'metrics']);


      // --- NOTIFICATIONS (subcollection) ---
      // Each user has their own notifications. Only owner can read.
      // Only the `read` flag can be flipped client-side; everything else is backend-only.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create, delete: if false; // backend only
      }
    }

    // --- ASSIGNMENTS ---
    match /assignments/{assignmentId} {
      allow read: if true; // TEMPORARY DEBUG: Open to verify connectivity
      allow create: if isNotSuspended() && request.resource.data.seekerId == request.auth.uid;
      allow update: if isNotSuspended() && (
        (resource.data.seekerId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeWriterId', 'status'])) ||
        (resource.data.activeWriterId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solution', 'status']))
      );
    }

    // --- BIDS ---
    match /bids/{bidId} {
      allow read: if request.auth != null && (
        resource.data.writerId == request.auth.uid || 
        get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.seekerId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.writerId == request.auth.uid;
      // Bids shouldn't be edited once placed, only deleted or handled by system
      allow update: if false;
    }

    // --- MESSAGES ---
    match /messages/{messageId} {
      // FIX #14: Only participants of the assignment can read messages.
      // We use get() to fetch the parent assignment and verify the caller is either 
      // the seeker or the active writer.
      allow read: if isNotSuspended() && (
        get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.seekerId == request.auth.uid ||
        get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.activeWriterId == request.auth.uid
      );
      allow create: if isNotSuspended() && request.resource.data.senderId == request.auth.uid;
    }

    // --- TRANSACTIONS & WALLETS ---
    // Strictly backend only for financial safety
    match /transactions/{transactionId} {
      // FIX: Users can read transactions where they are the receiver (writer payouts, top-ups)
      // OR the sender (seeker escrow locks, fees) — so both parties see their own history.
      allow read: if request.auth != null && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
      allow write: if false;
    }

    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // --- PAYMENT ORDERS (Cashfree intent records) ---
    // Backend writes only. Users can read their own order history if needed.
    match /paymentOrders/{orderId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // --- REVIEWS (post-completion ratings) ---
    // Anyone authenticated can read reviews (used to display writer profiles).
    // Reviews are written by the backend after assignment completion to ensure validity.
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
